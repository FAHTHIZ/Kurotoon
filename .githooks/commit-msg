#!/bin/sh
set -eu

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$HOOK_DIR/.." && pwd)

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$REPO_ROOT/scripts/commit_attribution.py" "$1"
fi
if command -v python >/dev/null 2>&1; then
  exec python "$REPO_ROOT/scripts/commit_attribution.py" "$1"
fi

echo "KuroToon commit hook: Python 3 is required to check commit attribution." >&2
exit 1
